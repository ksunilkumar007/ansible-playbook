---
- name: Validate CSV and Generate Kubernetes YAMLs
  hosts: localhost
  gather_facts: no

  vars:
    csv_file: "{{ playbook_dir }}/input/input.csv"  # Change as needed
    python_script: "{{ playbook_dir }}/scripts/generate_k8s_yaml.py"
    validation_script: "{{ playbook_dir }}/scripts/csv_validator.py"
    template_dir: "{{ playbook_dir }}/templates"
    output_dir: "{{ playbook_dir }}/output"

  tasks:
    - name: Validate CSV File
      command: "python3 {{ validation_script }} --csv_file {{ csv_file }}"
      register: validation_result
      ignore_errors: yes

    - name: Fail if CSV validation fails
      fail:
        msg: "CSV validation failed: {{ validation_result.stderr }}"
      when: validation_result.rc != 0

    - name: Generate Kubernetes YAMLs
      command: "python3 {{ python_script }} --csv_file {{ csv_file }} --template_dir {{ template_dir }} --output_dir {{ output_dir }}"
      when: validation_result.rc == 0
