---
- name: Validate CSV and Generate Kubernetes YAMLs
  hosts: localhost
  gather_facts: no

  vars:
    enable_serviceaccount: false  # Set to true to enable ServiceAccount processing
    enable_metallb: false  # Set to true to enable MetalLB processing

  tasks:
    - name: Load ServiceAccount Variables
      include_vars: vars/serviceaccount.yml
      when: enable_serviceaccount | bool

    - name: Include CSV Validation Task
      include_tasks: tasks/serviceaccount/csv_validation.yml
      when: enable_serviceaccount | bool

    - name: Include YAML Generation Task
      include_tasks: tasks/serviceaccount/generate_k8s.yml
      when: enable_serviceaccount | bool

    - name: Load ServiceAccount Variables
      include_vars: vars/metallb.yml
      when: enable_metallb | bool

    - name: Include CSV Validation Task
      include_tasks: tasks/metallb/csv_validation.yml
      when: enable_metallb | bool

    - name: Include YAML Generation Task
      include_tasks: tasks/metallb/generate_k8s.yml
      when: enable_metallb | bool